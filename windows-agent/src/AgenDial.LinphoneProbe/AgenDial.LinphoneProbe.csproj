<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LinphoneSDK.Windows" Version="5.5.2" />
  </ItemGroup>

  <!-- The 5.5.2 package contains native Windows x64 DLLs but no CsWrapper.dll. -->
  <Target Name="RemoveMissingLinphoneManagedWrapper" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="InjectReference">
    <ItemGroup>
      <Reference Remove="LinphoneSDK.Windows" />
    </ItemGroup>
  </Target>
</Project>
